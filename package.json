{
  "name": "buildpilot",
  "displayName": "BuildPilot for Claude Code",
  "description": "Mission control for Claude Code: see every session, what needs you, context and plan limits, what's broken and the next best step. Local-first, menu-bar widget on Mac.",
  "version": "0.9.0",
  "publisher": "buildpilot-local",
  "license": "UNLICENSED",
  "private": true,
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "AI",
    "Visualization",
    "Testing",
    "Other"
  ],
  "keywords": [
    "claude",
    "claude code",
    "anthropic",
    "ai agents",
    "agent supervisor",
    "mission control",
    "prompt",
    "hooks",
    "context window",
    "rate limit",
    "vibe coding",
    "menu bar"
  ],
  "galleryBanner": {
    "color": "#14161b",
    "theme": "dark"
  },
  "pricing": "Free",
  "qna": false,
  "main": "./dist/extension.js",
  "activationEvents": [
    "onStartupFinished",
    "onUri"
  ],
  "scripts": {
    "build": "node scripts/build.mjs && node scripts/build-plugin.mjs",
    "watch": "node scripts/build.mjs --watch",
    "typecheck": "tsc --noEmit -p .",
    "lint": "eslint src test",
    "test": "vitest run",
    "test:smoke": "node scripts/build.mjs && node test/smoke/run.mjs",
    "package": "node scripts/build.mjs && ([ \"$(uname)\" != Darwin ] || bash scripts/build-widget.sh) && vsce package --no-dependencies --readme-path docs/marketplace/README.md --no-rewrite-relative-links --out dist/buildpilot.vsix",
    "ci": "npm run typecheck && npm run lint && npm test && npm run test:smoke",
    "guide": "P=$(mktemp -d) && \"/Applications/Google Chrome.app/Contents/MacOS/Google Chrome\" --headless=new --disable-gpu --user-data-dir=\"$P\" --no-first-run --allow-file-access-from-files --no-pdf-header-footer --print-to-pdf=dist/START-HERE.pdf \"file://$PWD/docs/guide/guide.html\" 2>/dev/null; rm -rf \"$P\"",
    "desktop": "npm run package && npm run guide && node scripts/desktop.mjs",
    "build:widget": "bash scripts/build-widget.sh",
    "publish:vscode": "vsce publish --no-dependencies --packagePath dist/buildpilot.vsix",
    "publish:openvsx": "npx --yes ovsx publish dist/buildpilot.vsix"
  },
  "dependencies": {
    "sql.js": "^1.13.0"
  },
  "devDependencies": {
    "@types/jsdom": "^21.1.7",
    "@types/node": "^22.10.2",
    "@types/sql.js": "^1.4.9",
    "@types/vscode": "^1.90.0",
    "@vscode/codicons": "^0.0.36",
    "@vscode/test-electron": "^2.4.1",
    "@vscode/vsce": "^3.2.1",
    "axe-core": "^4.10.2",
    "esbuild": "^0.24.0",
    "eslint": "^9.39.0",
    "jsdom": "^25.0.1",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^4.0.0"
  },
  "icon": "media/icon.png",
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": "limited",
      "description": "In Restricted Mode BuildPilot only reads and analyzes. Running scripts, starting Claude Code and writing files are disabled."
    }
  },
  "contributes": {
    "commands": [
      {
        "command": "buildpilot.focus",
        "title": "Open",
        "category": "BuildPilot"
      },
      {
        "command": "buildpilot.refresh",
        "title": "Re-analyze Project",
        "category": "BuildPilot",
        "icon": "$(refresh)"
      },
      {
        "command": "buildpilot.selectProject",
        "title": "Select Project",
        "category": "BuildPilot"
      },
      {
        "command": "buildpilot.installHooks",
        "title": "Connect to Claude Code",
        "category": "BuildPilot"
      },
      {
        "command": "buildpilot.uninstallHooks",
        "title": "Disconnect from Claude Code",
        "category": "BuildPilot"
      },
      {
        "command": "buildpilot.newPrompt",
        "title": "New Prompt (Prompt Studio)",
        "category": "BuildPilot",
        "icon": "$(sparkle)"
      },
      {
        "command": "buildpilot.copyHandoff",
        "title": "Copy Session Handoff",
        "category": "BuildPilot"
      },
      {
        "command": "buildpilot.checkpoint",
        "title": "Save Checkpoint",
        "category": "BuildPilot"
      },
      {
        "command": "buildpilot.runTests",
        "title": "Run Tests",
        "category": "BuildPilot"
      },
      {
        "command": "buildpilot.showBrief",
        "title": "Show Brief",
        "category": "BuildPilot"
      },
      {
        "command": "buildpilot.loadDemo",
        "title": "Load Demo Sessions",
        "category": "BuildPilot"
      },
      {
        "command": "buildpilot.clearDemo",
        "title": "Remove Demo Sessions",
        "category": "BuildPilot"
      },
      {
        "command": "buildpilot.setAnthropicKey",
        "title": "Set Anthropic API Key (optional)",
        "category": "BuildPilot"
      },
      {
        "command": "buildpilot.setWebhook",
        "title": "Set Notification URL (phone, glasses, Slack\u2026)",
        "category": "BuildPilot"
      },
      {
        "command": "buildpilot.deleteProjectData",
        "title": "Delete This Project's Data",
        "category": "BuildPilot"
      },
      {
        "command": "buildpilot.deleteAllData",
        "title": "Delete All BuildPilot Data",
        "category": "BuildPilot"
      },
      {
        "command": "buildpilot.installStatusline",
        "title": "Show Exact Context % (Claude Code status line)",
        "category": "BuildPilot"
      },
      {
        "command": "buildpilot.uninstallStatusline",
        "title": "Remove Status Line Integration",
        "category": "BuildPilot"
      },
      {
        "command": "buildpilot.audit",
        "title": "Check Dependencies for Vulnerabilities",
        "category": "BuildPilot"
      },
      {
        "command": "buildpilot.visualCheck",
        "title": "Visual Check of Running App",
        "category": "BuildPilot"
      },
      {
        "command": "buildpilot.walkthrough",
        "title": "Getting Started",
        "category": "BuildPilot"
      },
      {
        "command": "buildpilot.installShell",
        "title": "Show in Every Terminal (bp command)",
        "category": "BuildPilot"
      },
      {
        "command": "buildpilot.uninstallShell",
        "title": "Remove from Terminal Startup",
        "category": "BuildPilot"
      },
      {
        "command": "buildpilot.installWidget",
        "title": "Add Menu-Bar Widget (macOS)",
        "category": "BuildPilot",
        "enablement": "isMac"
      },
      {
        "command": "buildpilot.uninstallWidget",
        "title": "Remove Menu-Bar Widget",
        "category": "BuildPilot",
        "enablement": "isMac"
      },
      {
        "command": "buildpilot.widgetLogin",
        "title": "Menu-Bar Widget: Start at Login",
        "category": "BuildPilot"
      },
      {
        "command": "buildpilot.enterLicense",
        "title": "Enter License Key",
        "category": "BuildPilot"
      },
      {
        "command": "buildpilot.removeBuilds",
        "title": "Remove Finished Builds",
        "category": "BuildPilot"
      }
    ],
    "keybindings": [
      {
        "command": "buildpilot.newPrompt",
        "key": "ctrl+alt+p",
        "mac": "cmd+alt+p"
      }
    ],
    "configuration": {
      "title": "BuildPilot",
      "properties": {
        "buildpilot.beginnerMode": {
          "type": "boolean",
          "default": true,
          "description": "Show short plain-English explanations of issues and recommendations."
        },
        "buildpilot.notifications": {
          "type": "string",
          "enum": [
            "important",
            "off"
          ],
          "default": "important",
          "enumDescriptions": [
            "Only when a session needs approval, fails, loops, or conflicts.",
            "Never show pop-ups."
          ],
          "description": "When BuildPilot may show a pop-up."
        },
        "buildpilot.ai.provider": {
          "type": "string",
          "enum": [
            "none",
            "anthropic",
            "ollama"
          ],
          "default": "none",
          "description": "Optional AI used only when you click 'Refine with AI'. 'anthropic' uses your own API key (BuildPilot: Set Anthropic API Key); 'ollama' uses a local model."
        },
        "buildpilot.ai.model": {
          "type": "string",
          "default": "",
          "description": "Model id, e.g. claude-sonnet-5-5 (Anthropic) or qwen2.5:7b (Ollama). Empty = sensible default."
        },
        "buildpilot.ai.ollamaUrl": {
          "type": "string",
          "default": "http://127.0.0.1:11434",
          "description": "Ollama base URL."
        },
        "buildpilot.integrationApi.enabled": {
          "type": "boolean",
          "default": false,
          "description": "Run the token-protected Integration API (read-only + prompt generation) for Shortcuts, Raycast, Stream Deck, smart-glasses companion apps, bots."
        },
        "buildpilot.integrationApi.port": {
          "type": "number",
          "default": 47821,
          "description": "Integration API port."
        },
        "buildpilot.integrationApi.allowLan": {
          "type": "boolean",
          "default": false,
          "markdownDescription": "Listen on your local network instead of only this computer, so a phone on the same Wi-Fi can reach it. **Only enable on trusted networks.** A token is always required."
        },
        "buildpilot.visualQa.url": {
          "type": "string",
          "default": "",
          "description": "Local address of your running app for Visual QA (e.g. http://localhost:3000). Empty = detect from package.json."
        },
        "buildpilot.openWithTerminal": {
          "type": "boolean",
          "default": true,
          "description": "Open the BuildPilot panel whenever you open a terminal or a new Claude Code session starts in this project (your cursor stays in the terminal)."
        },
        "buildpilot.theme": {
          "type": "string",
          "enum": [
            "white",
            "match"
          ],
          "default": "white",
          "enumDescriptions": [
            "Calm white page (default).",
            "Match your VS Code color theme (e.g. dark)."
          ],
          "description": "How the BuildPilot page looks."
        }
      }
    },
    "walkthroughs": [
      {
        "id": "buildpilot.start",
        "title": "Get started with BuildPilot",
        "description": "Mission control for building software with Claude Code, set up in two minutes.",
        "steps": [
          {
            "id": "open",
            "title": "Open Mission Control",
            "description": "See what's happening, what's wrong and what to do next.\n[Open BuildPilot](command:buildpilot.focus)",
            "media": {
              "markdown": "media/walkthrough/open.md"
            }
          },
          {
            "id": "connect",
            "title": "Connect to Claude Code",
            "description": "Let BuildPilot see your sessions (safe, local, reversible).\n[Connect](command:buildpilot.installHooks)\n[Show exact context %](command:buildpilot.installStatusline)",
            "media": {
              "markdown": "media/walkthrough/connect.md"
            }
          },
          {
            "id": "prompt",
            "title": "Write a prompt with Prompt Studio",
            "description": "Turn a plain-English goal into an expert Claude Code prompt.\n[Open Prompt Studio](command:buildpilot.newPrompt)",
            "media": {
              "markdown": "media/walkthrough/prompt.md"
            }
          },
          {
            "id": "supervise",
            "title": "Check your project",
            "description": "Tests, secrets, dependencies, visual check, checkpoints.\n[Save a checkpoint](command:buildpilot.checkpoint)",
            "media": {
              "markdown": "media/walkthrough/supervise.md"
            }
          },
          {
            "id": "menubar",
            "title": "Put BuildPilot in your menu bar",
            "description": "See every session and what needs you at a glance, even with VS Code closed.\n[Add to menu bar](command:buildpilot.installWidget)",
            "media": {
              "markdown": "media/walkthrough/menubar.md"
            },
            "when": "isMac",
            "completionEvents": [
              "onCommand:buildpilot.installWidget"
            ]
          },
          {
            "id": "phone",
            "title": "Alerts on your phone & glasses",
            "description": "Get told when Claude needs you, wherever you are.\n[Set up notifications](command:buildpilot.setWebhook)",
            "media": {
              "markdown": "media/walkthrough/phone.md"
            }
          }
        ]
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "buildpilot.widgetLogin",
          "when": "false"
        }
      ]
    }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/MatchappAI/buildpilot"
  },
  "homepage": "https://matchappai.github.io/buildpilot/",
  "bugs": {
    "url": "https://github.com/MatchappAI/buildpilot/issues"
  }
}
